          "editorMode": "code",
          "expr": "sum(rate(vllm:request_queue_time_seconds_sum{model_name=~\"$model\"}[$__rate_interval])) / clamp_min(sum(rate(vllm:request_queue_time_seconds_count{model_name=~\"$model\"}[$__rate_interval])), 1e-9)",
