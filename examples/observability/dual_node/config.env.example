# Copy to config.env and edit. Values below match this 2x DGX Spark pair:
#   head   192.168.101.12  (RoCE rail 1)
#   worker 192.168.101.13
# Quote ROCE_DEVICE_REGEX — it contains `|`.

# Grafana + Prometheus are loopback only. cloudflared publishes
# 127.0.0.1:3000 at https://token.asteraix.com/dash. Do not bind
# Wi-Fi (the address roams) or 0.0.0.0.
GRAFANA_BIND=127.0.0.1
GRAFANA_PASSWORD=admin
GRAFANA_DOMAIN=token.asteraix.com
GRAFANA_ROOT_URL=https://token.asteraix.com/dash/
GRAFANA_SERVE_FROM_SUB_PATH=true

PROMETHEUS_LISTEN=127.0.0.1:9091

# vLLM /metrics on the head (network=host). Worker is --headless.
VLLM_METRICS_TARGET=127.0.0.1:30001

# Head node_exporter: loopback. Prometheus on this host scrapes it
# locally; InfiniBand collectors still read /sys.
NODE_EXPORTER_LISTEN=127.0.0.1:9100
SPARK1_LABEL=spark-1
SPARK1_NODE_EXPORTER=127.0.0.1:9100

# Worker node_exporter: bind the RoCE IP (same as VLLM_HOST_IP).
# Head Prometheus scrapes this over the QSFP DAC, not Wi-Fi.
SPARK2_LABEL=spark-2
SPARK2_NODE_EXPORTER=192.168.101.13:9100

# Optional: scp/ssh install node_exporter on the worker over RoCE.
# SPARK2_SSH=user@192.168.101.13

# Active RoCE twins on the plugged QSFP (f1). Do not include f0 (Down).
ROCE_DEVICE_REGEX='rocep1s0f1|roceP2p1s0f1'
