# Copy to config.env and edit. Values below match a 2x DGX Spark
# pair with the QSFP DAC on port f1 (see `rdma link` / `ibdev2netdev`).

# Grafana listen address. Use 127.0.0.1 when cloudflared is on this
# host (Wi-Fi / RoCE IPs change). Bind 0.0.0.0 only if you also need
# LAN access; do not bind a roaming NIC.
GRAFANA_BIND=127.0.0.1
GRAFANA_PASSWORD=admin
# Public URL when cloudflared publishes Grafana at /dash.
# Raw URL only — do not paste markdown like [https://x](https://x).
GRAFANA_DOMAIN=token.asterayx.com
GRAFANA_ROOT_URL=https://token.asterayx.com/dash/
GRAFANA_SERVE_FROM_SUB_PATH=true

# Prometheus UI stays on loopback; Grafana scrapes it via host networking.
PROMETHEUS_LISTEN=127.0.0.1:9090

# vLLM OpenAI server /metrics. docker/gb10/run.sh and run-vision.sh
# publish the API on the host (network=host) at VLLM_PORT, default 30001.
# Only NODE_RANK=0 exposes this; the worker is --headless.
VLLM_METRICS_TARGET=127.0.0.1:30001

# node_exporter on this host (Spark-1 / head). Bind to Wi-Fi, not tun0.
NODE_EXPORTER_LISTEN=192.168.8.134:9100
SPARK1_LABEL=spark-1
SPARK1_NODE_EXPORTER=192.168.8.134:9100

# Spark-2 / worker. Fill the Wi-Fi IP after running `ip -br addr` there.
# Leave empty to scrape only this node.
SPARK2_LABEL=spark-2
SPARK2_NODE_EXPORTER=

# Optional: scp/ssh install node_exporter on Spark-2.
# SPARK2_SSH=user@192.168.100.11

# Active RoCE twins on the plugged QSFP (f1). Do not include f0 (Down).
ROCE_DEVICE_REGEX='rocep1s0f1|roceP2p1s0f1'
