# Install to /etc/cloudflared/config.yml (systemd). sudo service install
# does not read $HOME/.cloudflared — use ./install-service.sh.
# /dash MUST be listed before the hostname catch-all.
#
# Fill TUNNEL_ID from: cloudflared tunnel list
#   /dash  → Grafana 127.0.0.1:3000
#   rest   → spark-compat-proxy 127.0.0.1:30000 (/v1, /configs, /healthz)
# Do not originate :30001 (skips the reasoning alias). Do not add /telemetry.

tunnel: TUNNEL_ID
credentials-file: /etc/cloudflared/TUNNEL_ID.json

ingress:
  - hostname: token.asteraix.com
    path: /dash(/.*)?
    service: http://127.0.0.1:3000
    originRequest:
      httpHostHeader: token.asteraix.com
      disableChunkedEncoding: true

  - hostname: token.asteraix.com
    service: http://127.0.0.1:30000
    originRequest:
      httpHostHeader: token.asteraix.com
      disableChunkedEncoding: true
      connectTimeout: 10s
      keepAliveTimeout: 600s
      noHappyEyeballs: true

  - service: http_status:404
