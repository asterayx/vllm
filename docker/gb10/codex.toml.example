# Codex → Spark vLLM via the reasoning_content alias proxy.
# The proxy must be running on the head:
#   python3 docker/gb10/codex_proxy.py
#   # 0.0.0.0:30000 -> http://127.0.0.1:30001
#
# Copy/merge into ~/.codex/config.toml

model = "deepseek-v4-flash-vision-exp"
model_provider = "vllm"

[model_providers.vllm]
name = "vLLM Spark"
env_key = "VLLM_API_KEY"
base_url = "http://127.0.0.1:30000/v1"
wire_api = "responses"
