# Copy to head.env / worker.env on each Spark. Do not commit real IPs.
VLLM_GB10_IMAGE=vllm-gb10:dspark

# Hub id or a path already present under HF_CACHE
DSPARK_MODEL=deepseek-ai/DeepSeek-V4-Flash-0731
HF_CACHE=/home/CHANGE_ME/.cache/huggingface
VLLM_PORT=8000

# Two-node fabric. Same MASTER_ADDR on both nodes.
NNODES=2
NODE_RANK=0
HEADLESS=
MASTER_ADDR=CHANGE_ME_HEAD_CONNECTX_IP
MASTER_PORT=29500
NCCL_SOCKET_IFNAME=CHANGE_ME
NCCL_IB_HCA=CHANGE_ME
NCCL_IB_DISABLE=0

GPU_MEMORY_UTILIZATION=0.85
MAX_NUM_SEQS=8
MAX_NUM_BATCHED_TOKENS=8192
