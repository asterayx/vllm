# Copy to docker/gb10.head.env and docker/gb10.worker.env
VLLM_GB10_IMAGE=vllm-gb10:dspark

DSPARK_MODEL=/models/DeepSeek-V4-Flash-0731
MODEL_HOST=/home/CHANGE_ME/models/DeepSeek-V4-Flash-0731
HF_CACHE=/home/CHANGE_ME/.cache/huggingface
VLLM_CACHE=/home/CHANGE_ME/vllm-cache
VLLM_PORT=30001
HF_HUB_OFFLINE=1
TRANSFORMERS_OFFLINE=1

NNODES=2
NODE_RANK=0
HEADLESS=
MASTER_ADDR=192.168.100.10
MASTER_PORT=29500
VLLM_HOST_IP=192.168.100.10

NCCL_NET=IB
NCCL_IB_DISABLE=0
NCCL_IB_MERGE_NICS=1
NCCL_CROSS_NIC=1
NCCL_CUMEM_ENABLE=0
NCCL_NVLS_ENABLE=0
NCCL_IB_ROCE_VERSION_NUM=2
NCCL_IB_ADDR_FAMILY=AF_INET
NCCL_SOCKET_IFNAME=enp1s0f1np1
NCCL_IB_HCA=rocep1s0f1,roceP2p1s0f1
NCCL_DEBUG=WARN

GPU_MEMORY_UTILIZATION=0.85
MAX_MODEL_LEN=524288
MAX_NUM_SEQS=6
MAX_NUM_BATCHED_TOKENS=8192
# 6 seqs * (1 + DSpark k=5). Must also list 36 in cudagraph_capture_sizes
# or vLLM truncates to 32 (default step 8).
MAX_CUGRAPH=36
