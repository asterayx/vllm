# DGX Spark / ASUS GX10 (GB10, SM121, aarch64) image.
# Baseline: official vLLM v0.28.0 + Spark DSv4-Flash patches.
# Pins: FlashInfer 0.6.18 (requirements/cuda.txt), official b12x==1.2.6,
# humming-kernels[cu13]==0.1.12 (SM121 leftover W8A8 before Triton).
# Build ON a Spark (linux/arm64 + GPU). Do not cross-build from x86.
#
#   docker/gb10/build.sh
#   docker/gb10/sync-image.sh user@<other-spark-connectx-ip>

ARG CUDA_VERSION=13.0.1
ARG UBUNTU_VERSION=24.04
FROM nvidia/cuda:${CUDA_VERSION}-devel-ubuntu${UBUNTU_VERSION}

ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONUNBUFFERED=1 \
    VIRTUAL_ENV=/opt/venv \
    PATH=/opt/venv/bin:/usr/local/cuda/bin:${PATH} \
    CUDA_HOME=/usr/local/cuda \
    TORCH_CUDA_ARCH_LIST=12.1a \
    FLASHINFER_CUDA_ARCH_LIST=12.1a \
    VLLM_TARGET_DEVICE=cuda \
    VLLM_USE_DEEP_GEMM=0 \
    UV_SYSTEM_PYTHON=0

RUN apt-get update && apt-get install -y --no-install-recommends \
        python3.12 \
        python3.12-venv \
        python3.12-dev \
        python3-pip \
        git \
        curl \
        ca-certificates \
        ninja-build \
        cmake \
        build-essential \
        libibverbs1 \
        ibverbs-providers \
        ibverbs-utils \
        libmlx5-1 \
        librdmacm1 \
        rdma-core \
    && rm -rf /var/lib/apt/lists/* \
    && ln -sf /usr/bin/python3.12 /usr/local/bin/python

RUN curl -LsSf https://astral.sh/uv/install.sh | sh
ENV PATH="/root/.local/bin:${PATH}"

WORKDIR /opt/vllm
COPY . /opt/vllm

# PyTorch's cu130 index ships packaging<=24.1; FlashInfer 0.6.18 needs >=24.2.
# Same strategy as the stock CUDA Dockerfile.
# --torch-backend cu130 is required: unsafe-best-match can otherwise pick
# PyPI's CPU torch==2.13.0 over torch==2.13.0+cu130, and then setup.py
# skips vllm._C_stable_libtorch.
ENV UV_INDEX_STRATEGY=unsafe-best-match \
    UV_LINK_MODE=copy

# GB10 has ~20 ARM cores and 128GB unified memory. 8 is the idle-build
# default; raise with --build-arg MAX_JOBS=12 if `free` stays comfortable.
ARG MAX_JOBS=8
# uv cache mount: rebuilds reuse wheels (torch/FlashInfer) without a host
# venv. Do not rm /root/.cache/uv — that wipes the mount. The mount is
# not committed into the image. To copy a fully compiled host venv
# instead, use docker/gb10/pack-venv.sh.
RUN --mount=type=cache,target=/root/.cache/uv \
    if [ "$(uname -m)" = "aarch64" ]; then \
        printf 'cython<3.3\n' > /tmp/build-constraints.txt \
        && export UV_BUILD_CONSTRAINT=/tmp/build-constraints.txt; \
    fi \
    && uv venv --python 3.12 /opt/venv \
    && uv pip install --python /opt/venv/bin/python \
        --torch-backend cu130 \
        --extra-index-url https://download.pytorch.org/whl/cu130 \
        -r requirements/cuda.txt \
    && /opt/venv/bin/python -c "import torch; assert torch.version.cuda, torch.__version__; print('torch', torch.__version__, 'cuda', torch.version.cuda, flush=True)" \
    && /opt/venv/bin/python use_existing_torch.py --prefix \
    && uv pip install --python /opt/venv/bin/python \
        --torch-backend cu130 \
        --extra-index-url https://download.pytorch.org/whl/cu130 \
        -r requirements/build/cuda.txt \
    && chmod +x /opt/vllm/docker/gb10/install-vllm.sh \
    && MAX_JOBS=${MAX_JOBS} TORCH_CUDA_ARCH_LIST=12.1a VLLM_TARGET_DEVICE=cuda \
        /opt/vllm/docker/gb10/install-vllm.sh /opt/venv/bin/python \
    && (uv pip uninstall --python /opt/venv/bin/python flashinfer-jit-cache || true) \
    && chmod +x /opt/vllm/docker/gb10/entrypoint.sh \
               /opt/vllm/docker/gb10/install-b12x.sh \
    && /opt/vllm/docker/gb10/install-b12x.sh /opt/venv/bin/python \
    && rm -rf /root/.cache/flashinfer

# Humming after compile so a pin tweak does not rebuild CUDA extensions.
# cuda.txt already pins it; re-run so a cache hit still has it, and so
# has_humming() is asserted against the baked tree. SM121 leftover W8A8
# prefers Humming over the untuned Triton default.
COPY docker/gb10/install-humming.sh /opt/vllm/docker/gb10/install-humming.sh
ARG INSTALL_HUMMING=1
RUN --mount=type=cache,target=/root/.cache/uv \
    chmod +x /opt/vllm/docker/gb10/install-humming.sh \
    && INSTALL_HUMMING=${INSTALL_HUMMING} \
        /opt/vllm/docker/gb10/install-humming.sh /opt/venv/bin/python

# Own Spark release (docker/gb10/VERSION). Copied after compile so bumping
# 0.28.0+dsv4.spark.N does not rebuild CUDA extensions or humming.
COPY docker/gb10/VERSION /opt/vllm/docker/gb10/VERSION
ARG VLLM_SPARK_VERSION=0.28.0+dsv4.spark.2
ENV VLLM_SPARK_VERSION=${VLLM_SPARK_VERSION} \
    VLLM_VERSION_OVERRIDE=${VLLM_SPARK_VERSION} \
    SETUPTOOLS_SCM_PRETEND_VERSION=${VLLM_SPARK_VERSION} \
    VLLM_GB10_VERSION=${VLLM_SPARK_VERSION}
LABEL org.opencontainers.image.version="${VLLM_SPARK_VERSION}" \
      org.opencontainers.image.title="vLLM GB10 Spark DSv4"
RUN /opt/venv/bin/python /opt/vllm/docker/gb10/stamp-version.py \
        "${VLLM_SPARK_VERSION}" --root /opt/vllm

EXPOSE 8000
ENTRYPOINT ["/opt/vllm/docker/gb10/entrypoint.sh"]
CMD ["vllm", "--help"]
