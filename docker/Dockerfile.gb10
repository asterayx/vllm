# DGX Spark / ASUS GX10 (GB10, SM121, aarch64) image for this branch.
# Build ON a Spark (or another linux/arm64 + GPU host). Do not cross-build
# from x86. After one successful build, docker save | ssh docker load
# the image to the second node instead of rsyncing a venv.
#
#   docker/gb10/build.sh
#   docker/gb10/sync-image.sh user@<other-spark-connectx-ip>

ARG CUDA_VERSION=13.0.1
ARG UBUNTU_VERSION=24.04
FROM nvidia/cuda:${CUDA_VERSION}-devel-ubuntu${UBUNTU_VERSION}

ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONUNBUFFERED=1 \
    VIRTUAL_ENV=/opt/venv \
    PATH=/opt/venv/bin:/usr/local/cuda/bin:${PATH} \
    CUDA_HOME=/usr/local/cuda \
    TORCH_CUDA_ARCH_LIST=12.1a \
    FLASHINFER_CUDA_ARCH_LIST=12.1a \
    VLLM_USE_DEEP_GEMM=0 \
    UV_SYSTEM_PYTHON=0

RUN apt-get update && apt-get install -y --no-install-recommends \
        python3.12 \
        python3.12-venv \
        python3.12-dev \
        python3-pip \
        git \
        curl \
        ca-certificates \
        ninja-build \
        build-essential \
        libibverbs1 \
        rdma-core \
    && rm -rf /var/lib/apt/lists/* \
    && ln -sf /usr/bin/python3.12 /usr/local/bin/python

RUN curl -LsSf https://astral.sh/uv/install.sh | sh
ENV PATH="/root/.local/bin:${PATH}"

WORKDIR /opt/vllm
COPY . /opt/vllm

# GB10 has ~20 ARM cores and 128GB unified memory. 8 is the idle-build
# default; raise with --build-arg MAX_JOBS=12 if `free` stays comfortable.
ARG MAX_JOBS=8
RUN grep -v '^flashinfer' requirements/cuda.txt > /tmp/cuda-no-flashinfer.txt \
    && if [ "$(uname -m)" = "aarch64" ]; then \
        printf 'cython<3.3\n' > /tmp/build-constraints.txt \
        && export UV_BUILD_CONSTRAINT=/tmp/build-constraints.txt; \
    fi \
    && uv venv --python 3.12 /opt/venv \
    && uv pip install --python /opt/venv/bin/python \
        --extra-index-url https://download.pytorch.org/whl/cu130 \
        -r /tmp/cuda-no-flashinfer.txt \
    && /opt/venv/bin/python use_existing_torch.py --prefix \
    && MAX_JOBS=${MAX_JOBS} TORCH_CUDA_ARCH_LIST=12.1a \
        uv pip install --python /opt/venv/bin/python \
        --no-build-isolation -e . \
    && uv pip install --python /opt/venv/bin/python \
        -r requirements/flashinfer-sm12x-nightly.txt \
    && uv pip uninstall --python /opt/venv/bin/python flashinfer-jit-cache || true \
    && chmod +x /opt/vllm/docker/gb10/entrypoint.sh \
    && rm -rf /root/.cache/uv /root/.cache/flashinfer

EXPOSE 8000
ENTRYPOINT ["/opt/vllm/docker/gb10/entrypoint.sh"]
CMD ["vllm", "--help"]
